---
import '../styles/global.css';
import { SITE } from '../site.config';
import { abs, categoryUrl, getCategory } from '../lib/content';
import TickerBar from '../components/TickerBar.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
  markdownAlt?: string;
  prev?: string;
  next?: string;
  fullTitle?: boolean;
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  image = SITE.defaultImage,
  imageAlt = SITE.name,
  type = 'website',
  noindex = false,
  jsonLd = [],
  article,
  markdownAlt,
  prev,
  next,
  fullTitle = false,
} = Astro.props;

const canonical = abs(path);
const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const ogImage = abs(image);

const orgId = `${SITE.url}/#organization`;
const baseGraph = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: abs(SITE.logo), width: 512, height: 512 },
    ...(SITE.sameAs.length ? { sameAs: SITE.sameAs } : {}),
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: SITE.locale,
    publisher: { '@id': orgId },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/busca/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
];
const ld = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...jsonLd] };
const navCats = SITE.nav.map(getCategory).filter((c) => c.count > 0);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    {prev && <link rel="prev" href={abs(prev)} />}
    {next && <link rel="next" href={abs(next)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b3d2e" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {markdownAlt && <link rel="alternate" type="text/markdown" title="Versão em Markdown" href={markdownAlt} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    {SITE.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
        <script is:inline define:vars={{ id: SITE.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date()); gtag('config', id);
        </script>
      </>
    )}
    {SITE.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="logo" aria-label={`${SITE.name} — página inicial`}>
          <span class="logo-mark" aria-hidden="true">5</span>
          <span class="logo-text">Cinco<b>Invest</b><span class="arrow" aria-hidden="true">⤴</span></span>
        </a>
        <nav class="main-nav" aria-label="Categorias">
          <ul>
            {navCats.map((c) => <li><a href={categoryUrl(c.slug)} aria-current={Astro.url.pathname === categoryUrl(c.slug) ? 'page' : undefined}>{c.name}</a></li>)}
          </ul>
        </nav>
        <a href="/busca/" class="search-link" aria-label="Buscar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
      </div>
    </header>
    <TickerBar />

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">{SITE.brand}</p>
          <p>{SITE.tagline}. {SITE.description}</p>
        </div>
        <nav aria-label="Rodapé">
          <p class="footer-title">Categorias</p>
          <ul>{navCats.map((c) => <li><a href={categoryUrl(c.slug)}>{c.name}</a></li>)}</ul>
        </nav>
        <nav aria-label="Institucional">
          <p class="footer-title">Institucional</p>
          <ul>
            <li><a href="/sobre/">Sobre o Cinco Invest</a></li>
            <li><a href="/politica-de-privacidade/">Política de privacidade</a></li>
            <li><a href="/tag/">Todos os temas</a></li>
            <li><a href="/rss.xml">RSS</a></li>
            <li><a href="/llms.txt">llms.txt (para IAs)</a></li>
          </ul>
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <p class="disclaimer">{SITE.disclaimer}</p>
        <p>© {year} {SITE.name}. Todos os direitos reservados.</p>
      </div>
    </footer>
  </body>
</html>
