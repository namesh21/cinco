---
import ListingView from '../../components/ListingView.astro';
import { getPosts, paginate } from '../../lib/content';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const chunks = paginate(await getPosts());
  return chunks.slice(1).map((posts, i) => ({ params: { page: String(i + 2) }, props: { posts, current: i + 2, total: chunks.length } }));
}
const { posts, current, total } = Astro.props;
---
<ListingView
  title="Todos os artigos"
  heading="Todos os artigos"
  description={SITE.description}
  {posts} {current} {total}
  base="/"
  kind="Blog"
  crumbs={[{ name: `Página ${current}` }]}
/>
